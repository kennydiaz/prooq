---
// Listado de blog compartido por las apps país. Recibe los posts ya cargados
// (cada app llama a getCollection en su propia página). Base-aware y localizable.
// Se muestra como grilla de tarjetas con la imagen destacada de cada artículo.
export interface BlogListItem {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  /** URL absoluta de la imagen destacada (si el artículo tiene). */
  heroImage?: string | null;
}

export interface Props {
  posts: BlogListItem[];
  /** Locale para fechas y textos de UI, p.ej. 'es-PA', 'es-ES', 'en-US'. */
  locale?: string;
}

const { posts, locale = 'es-PA' } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const en = locale.startsWith('en');
const t = {
  heading: 'Blog',
  subtitle: en
    ? 'Practical technology and automation ideas to grow your business.'
    : 'Ideas prácticas de tecnología y automatización para hacer crecer tu negocio.',
  empty: en
    ? 'We will publish our first articles soon.'
    : 'Pronto publicaremos nuestros primeros artículos.',
  more: en ? 'Read article →' : 'Leer artículo →',
};

const fmt = (d: Date) =>
  d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="section blog-list-section">
  <div class="section-container">
    <h1 class="section-title">{t.heading}</h1>
    <p class="section-subtitle">{t.subtitle}</p>

    {posts.length === 0 && <p class="empty">{t.empty}</p>}

    <ul class="post-grid">
      {posts.map((post) => (
        <li class="post-card">
          <a href={`${BASE}blog/${post.slug}`} class="post-link">
            {post.heroImage ? (
              <img class="post-thumb" src={post.heroImage} alt={post.title} loading="lazy" />
            ) : (
              <div class="post-thumb post-thumb--placeholder" aria-hidden="true">
                <span>PROOQ</span>
              </div>
            )}
            <div class="post-body">
              <time datetime={post.pubDate.toISOString()} class="post-date">
                {fmt(post.pubDate)}
              </time>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-desc">{post.description}</p>
              {post.tags && post.tags.length > 0 && (
                <div class="post-tags">
                  {post.tags.map((tag) => (
                    <span class="post-tag">#{tag}</span>
                  ))}
                </div>
              )}
              <span class="post-more">{t.more}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* El header del sitio es fijo (~116px); subimos el padding superior para que
     el título "Blog" no quede tapado por el menú. */
  .blog-list-section {
    padding-top: clamp(8rem, 6rem + 4vw, 10rem);
  }

  .empty {
    color: var(--color-text-muted);
    text-align: center;
  }

  .post-grid {
    list-style: none;
    padding: 0;
    margin: 2rem auto 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--color-surface-raised);
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--color-brand-light);
    transform: translateY(-2px);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .post-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .post-thumb--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-surface-deep) 100%);
  }

  .post-thumb--placeholder span {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.7);
    font-size: 1.25rem;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    flex: 1;
  }

  .post-date {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    margin: 0;
    color: var(--color-text);
  }

  .post-desc {
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-size: 0.75rem;
    color: var(--color-brand-light);
    background: rgb(0 60 255 / 0.12);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .post-more {
    margin-top: auto;
    padding-top: 0.25rem;
    color: var(--color-accent-cyan);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
