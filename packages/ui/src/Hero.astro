---
/**
 * Hero de las sucursales país.
 *
 * Titular grande alineado a la izquierda (con una parte resaltada en gradiente) y, a la
 * derecha, una "órbita" animada en CSS puro: anillos girando alrededor de un hexágono
 * (el motivo de la marca) con las capacidades de la sucursal flotando alrededor.
 * Fondo transparente para que se vea el fondo animado de cada país. Sin JavaScript;
 * respeta prefers-reduced-motion.
 */
export interface HeroCta {
  label: string;
  href: string;
}

export interface Props {
  /** Texto corto sobre el titular, p. ej. "Sede principal · Ciudad de Panamá". */
  eyebrow?: string;
  /** Titular (h1). */
  title: string;
  /** Fragmento literal de `title` que se pinta con gradiente. */
  highlight?: string;
  description?: string;
  cta?: HeroCta;
  secondaryCta?: HeroCta;
  /** Capacidades que flotan alrededor de la órbita (se usan hasta 4). */
  tags?: string[];
}

const { eyebrow, title, highlight, description, cta, secondaryCta, tags = [] } = Astro.props;

const at = highlight ? title.indexOf(highlight) : -1;
const titleParts =
  highlight && at >= 0
    ? { before: title.slice(0, at), mark: highlight, after: title.slice(at + highlight.length) }
    : { before: title, mark: '', after: '' };

const orbitTags = tags.slice(0, 4);
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      {eyebrow && (
        <p class="hero-eyebrow">
          <span class="hero-pulse" aria-hidden="true"></span>
          <span>{eyebrow}</span>
        </p>
      )}
      <h1 class="hero-title">
        {titleParts.before}
        {titleParts.mark && <span class="hero-mark">{titleParts.mark}</span>}
        {titleParts.after}
      </h1>
      {description && <p class="hero-description">{description}</p>}
      {(cta || secondaryCta) && (
        <div class="hero-actions">
          {cta && (
            <a href={cta.href} class="hero-btn hero-btn-primary">
              {cta.label}
              <span class="hero-btn-arrow" aria-hidden="true">→</span>
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="hero-btn hero-btn-ghost">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="orbit-glow"></div>
      <div class="orbit-ring ring-outer"><span class="orbit-node"></span><span class="orbit-node node-b"></span></div>
      <div class="orbit-ring ring-mid"><span class="orbit-node"></span></div>
      <div class="orbit-ring ring-inner"><span class="orbit-node node-b"></span></div>
      <svg class="orbit-core" viewBox="0 0 120 120">
        <defs>
          <linearGradient id="hero-core-stroke" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#00ffe7" />
            <stop offset="55%" stop-color="#4d9fff" />
            <stop offset="100%" stop-color="#003cff" />
          </linearGradient>
          <linearGradient id="hero-core-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#4d9fff" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#003cff" stop-opacity="0.06" />
          </linearGradient>
        </defs>
        <path
          d="M60 8 L105 34 L105 86 L60 112 L15 86 L15 34 Z"
          fill="url(#hero-core-fill)"
          stroke="url(#hero-core-stroke)"
          stroke-width="2.5"
          stroke-linejoin="round"
        />
        <path
          d="M60 32 L84 46 L84 74 L60 88 L36 74 L36 46 Z"
          fill="none"
          stroke="url(#hero-core-stroke)"
          stroke-width="1.5"
          stroke-linejoin="round"
          opacity="0.7"
        />
        <circle cx="60" cy="60" r="5" fill="#00ffe7" />
      </svg>
      {orbitTags.map((tag, i) => <span class={`orbit-tag tag-${i + 1}`}>{tag}</span>)}
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true"><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 140px 2rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* Retícula tenue que se desvanece hacia los bordes */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(77 159 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(77 159 255 / 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 65% 45%, #000 20%, transparent 75%);
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  /* Entrada escalonada del texto */
  .hero-copy > * {
    animation: hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.24s; }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    padding: 0.4rem 1rem 0.4rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-text-soft);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .hero-pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-neon);
    box-shadow: 0 0 10px var(--color-accent-neon);
  }
  .hero-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent-neon);
    animation: hero-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes hero-ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .hero-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-body);
    font-size: clamp(2.5rem, 5.4vw, 4.6rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .hero-mark {
    background: linear-gradient(
      100deg,
      var(--color-accent-cyan) 0%,
      var(--color-brand-light) 45%,
      #8b5cf6 70%,
      var(--color-accent-cyan) 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: hero-shimmer 7s ease-in-out infinite alternate;
  }

  @keyframes hero-shimmer {
    to {
      background-position: 100% 0;
    }
  }

  .hero-description {
    max-width: 36rem;
    margin: 0 0 2.25rem;
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.7rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease,
      border-color 0.25s ease;
  }

  .hero-btn-primary {
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
    color: var(--color-text);
    box-shadow: var(--shadow-cta), inset 0 1px 0 rgb(255 255 255 / 0.25);
  }

  .hero-btn-primary:hover,
  .hero-btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-cta-hover), inset 0 1px 0 rgb(255 255 255 / 0.25);
  }

  .hero-btn-arrow {
    transition: transform 0.25s ease;
  }
  .hero-btn-primary:hover .hero-btn-arrow,
  .hero-btn-primary:focus-visible .hero-btn-arrow {
    transform: translateX(4px);
  }

  .hero-btn-ghost {
    color: var(--color-text);
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-btn-ghost:hover,
  .hero-btn-ghost:focus-visible {
    border-color: var(--color-brand-light);
    background: rgb(77 159 255 / 0.1);
  }

  /* ---------- Órbita ---------- */
  .hero-visual {
    position: relative;
    width: min(460px, 100%);
    aspect-ratio: 1;
    justify-self: center;
    animation: hero-rise 1.1s 0.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .orbit-glow {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--color-brand),
      var(--color-accent-cyan),
      #8b5cf6,
      var(--color-brand)
    );
    filter: blur(48px);
    opacity: 0.45;
    animation: orbit-spin 14s linear infinite;
  }

  .orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.09);
  }

  .ring-outer {
    inset: 0;
    border-style: dashed;
    border-color: rgb(77 159 255 / 0.28);
    animation: orbit-spin 60s linear infinite;
  }

  .ring-mid {
    inset: 13%;
    animation: orbit-spin 38s linear infinite reverse;
  }

  .ring-inner {
    inset: 26%;
    border-color: rgb(0 255 231 / 0.18);
    animation: orbit-spin 24s linear infinite;
  }

  .orbit-node {
    position: absolute;
    top: -5px;
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent-cyan);
    box-shadow: 0 0 12px var(--color-accent-cyan), 0 0 28px rgb(0 255 231 / 0.5);
  }

  .orbit-node.node-b {
    top: auto;
    bottom: -4px;
    width: 8px;
    height: 8px;
    left: calc(50% - 4px);
    background: var(--color-brand-light);
    box-shadow: 0 0 12px var(--color-brand-light);
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .orbit-core {
    position: absolute;
    inset: 36%;
    width: 28%;
    height: 28%;
    filter: drop-shadow(0 0 18px rgb(77 159 255 / 0.55));
    animation: core-breathe 5s ease-in-out infinite;
  }

  @keyframes core-breathe {
    50% {
      transform: scale(1.06);
      filter: drop-shadow(0 0 30px rgb(0 255 231 / 0.6));
    }
  }

  .orbit-tag {
    position: absolute;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(10 24 51 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    animation: tag-float 6s ease-in-out infinite;
  }

  .tag-1 { top: 8%; left: -4%; }
  .tag-2 { top: 30%; right: -8%; animation-delay: -1.5s; }
  .tag-3 { bottom: 20%; left: -10%; animation-delay: -3s; }
  .tag-4 { bottom: 4%; right: 2%; animation-delay: -4.5s; }

  @keyframes tag-float {
    50% {
      transform: translateY(-10px);
    }
  }

  /* ---------- Indicador de scroll ---------- */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    width: 24px;
    height: 38px;
    margin-left: -12px;
    border: 2px solid rgb(255 255 255 / 0.25);
    border-radius: 14px;
  }

  .hero-scroll span {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-text-soft);
    animation: scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes scroll-cue {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding: 130px 1.25rem 4.5rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .hero-visual {
      width: min(340px, 78vw);
    }
    .tag-1 { left: -8%; }
    .tag-2 { right: -12%; }
    .tag-3 { left: -12%; }
    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-description {
      font-size: 1rem;
    }
    .hero-btn {
      flex: 1 1 100%;
      justify-content: center;
    }
    .orbit-tag {
      font-size: 0.72rem;
      padding: 0.4rem 0.7rem;
    }
    .tag-1 { left: -6%; }
    .tag-2 { right: -6%; }
    .tag-3 { left: -8%; }
  }

  @media (max-height: 700px) {
    .hero-scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero *,
    .hero *::after {
      animation: none !important;
    }
  }
</style>
